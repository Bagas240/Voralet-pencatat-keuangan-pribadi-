<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_pet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_bg_pet">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_pet_avatar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐶"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/widget_pet_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Milo (Dog)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_pet_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🪙 50"
            android:textColor="#FFE082"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="@drawable/widget_pill_bg" />
    </LinearLayout>

    <!-- Stats row: Kenyang & Senang -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_pet_fullness_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kenyang 🍖"
                android:textColor="#FFCC80"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_pet_fullness_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="80%"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#37474F" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_pet_happiness_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Senang ❤️"
                android:textColor="#F48FB1"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/widget_pet_happiness_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="85%"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer Action -->
    <TextView
        android:id="@+id/widget_pet_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Beri makan &amp; elus peliharaan di Voralet ➜"
        android:textColor="#B0BEC5"
        android:textSize="10sp"
        android:gravity="center"
        android:ellipsize="end"
        android:singleLine="true" />
</LinearLayout>
